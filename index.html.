
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Farhan Gym | Jigjiga</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101820;
      color: white;
      text-align: center;
    }

    header {
      background: #202b35;
      padding: 20px 10px;
    }

    h1, .price { color: #39e75f; }

    nav a {
      color: white;
      margin: 8px;
      text-decoration: none;
    }

    .hero { padding: 35px 15px; }

    .gym-photo img {
      width: 100%;
      max-width: 500px;
      height: auto;
      border-radius: 12px;
      margin-top: 15px;
    }

    #plans { padding: 20px 10px; }

    .plans {
      background: #202b35;
      margin: 15px auto;
      padding: 20px;
      border-radius: 12px;
      max-width: 400px;
    }

    .price {
      font-size: 24px;
      font-weight: bold;
    }

    .button {
      display: inline-block;
      background: #39e75f;
      color: #101820;
      border: none;
      padding: 13px 20px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      text-decoration: none;
      margin: 8px;
    }

    .whatsapp { background: #25D366; color: white; }

    footer {
      background: #202b35;
      padding: 18px;
      margin-top: 20px;
    }
  </style>
</head>

<body>

  <header>
    <h1>FARHAN GYM</h1>
    <p>Build Strength. Build Confidence.</p>
    <nav>
      <a href="#home">Home</a>
      <a href="#plans">Plans</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <h2>Build Your Strength</h2>
    <p>Train hard. Stay strong. Reach your goals.</p>

    <div class="gym-photo">
      <img src="gym.jpg" alt="Farhan Gym">
    </div>

    <p>Welcome to Farhan Gym in Jigjiga!</p>
    <a class="button" href="#plans">View Membership Plans</a>
  </section>

  <section id="plans">
    <h2>Membership Plans</h2>

    <div class="plans">
      <h3>Monthly Plan</h3>
      <p class="price">4000 ETB</p>
      <p>One month of gym membership</p>
      <a class="button" href="https://wa.me/251933906666?text=Hello%20Farhan%20Gym%2C%20I%20want%20the%20monthly%20plan.">
        Join Now
      </a>
    </div>

    <div class="plans">
      <h3>3-Month Plan</h3>
      <p class="price">Ask us</p>
      <p>Contact us for pricing</p>
      <a class="button" href="https://wa.me/251933906666">
        Ask on WhatsApp
      </a>
    </div>

    <div class="plans">
      <h3>6-Month Plan</h3>
      <p class="price">Ask us</p>
      <p>Contact us for pricing</p>
      <a class="button" href="https://wa.me/251933906666">
        Ask on WhatsApp
      </a>
    </div>

    <div class="plans">
      <h3>1-Year Plan</h3>
      <p class="price">Ask us</p>
      <p>Contact us for pricing</p>
      <a class="button" href="https://wa.me/251933906666">
        Ask on WhatsApp
      </a>
    </div>
  </section>

  <section id="contact" class="hero">
    <h2>Contact Farhan Gym</h2>
    <p>📍 Jigjiga, Zone 04, Ayyardaga Street</p>
    <a class="button whatsapp"
       href="https://wa.me/251933906666"
       target="_blank"
       rel="noopener">
      Contact Us on WhatsApp
    </a>
  </section>

  <footer>
    <p>Farhan Gym | Jigjiga, Ethiopia</p>
  </footer>

</body>
</html>


